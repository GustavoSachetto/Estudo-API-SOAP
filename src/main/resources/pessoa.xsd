<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://gsachetto.com/soap/entity/pessoa"
           targetNamespace="http://gsachetto.com/soap/entity/pessoa"
           elementFormDefault="qualified">
    
    
    <xs:element name="getPessoaRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nome" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getPessoaResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nome" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>